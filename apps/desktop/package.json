{
  "name": "@fantasta/desktop",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Aste di Fantacalcio in locale, con regia desktop e partecipanti collegati dalla LAN",
  "author": "Davide Pirovano",
  "homepage": "https://github.com/Davide-Pirovano/FANTASTA",
  "repository": {
    "type": "git",
    "url": "https://github.com/Davide-Pirovano/FANTASTA.git"
  },
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./src/server.ts",
    "./database": "./src/database/index.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "test": "tsx --test src/database/database.test.ts src/server.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/main.ts",
    "electron": "electron electron/main.cjs",
    "bundle:server": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/local-server.cjs --external:node:*",
    "package": "npm run bundle:server && electron-builder"
  },
  "dependencies": {
    "@fantasta/contracts": "0.3.1",
    "@fantasta/domain": "0.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "it.fantasta.desktop",
    "productName": "Fantasta",
    "asar": true,
    "compression": "normal",
    "copyright": "Copyright © 2026 Davide Pirovano",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/local-server.cjs",
        "to": "local-server.cjs"
      },
      {
        "from": "../web/.next/standalone/apps",
        "to": "web/apps"
      },
      {
        "from": "../web/.next/standalone/packages",
        "to": "web/packages"
      },
      {
        "from": "../web/.next/standalone/package.json",
        "to": "web/package.json"
      },
      {
        "from": "../web/.next/standalone/node_modules",
        "to": "web/node_modules"
      },
      {
        "from": "../web/.next/static",
        "to": "web/apps/web/.next/static"
      },
      {
        "from": "../web/public",
        "to": "web/apps/web/public"
      }
    ],
    "artifactName": "Fantasta-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.sports",
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "Fantasta"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Fantasta"
    }
  }
}

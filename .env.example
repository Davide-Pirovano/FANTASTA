# Valori predefiniti per l'ambiente locale Supabase (Docker)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# URL raggiungibile dal server Next.js. Dentro Docker (docker-compose) viene
# impostato automaticamente a http://host.docker.internal:54321 perché
# 127.0.0.1 punterebbe al container stesso. Per sviluppo locale su host
# può coincidere con NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_SERVER_URL=http://127.0.0.1:54321
NEXT_PUBLIC_APP_URL=http://localhost:3000
